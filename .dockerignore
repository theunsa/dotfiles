# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore the Nuxt design prototype. It is the reference for the public page's
# look and for the markdown authoring format, and nothing in the app touches it
# at runtime. Its node_modules alone is 414MB, which `COPY . .` would otherwise
# bake into the final image and push to ghcr on every deploy.
/nuxt-prototype/

# Ignore local tooling and agent state.
/.ruby-lsp/
/.claude/

# Ignore assets. Unanchored, so it also catches node_modules in a subdirectory —
# the anchored form missed the prototype's copy entirely.
node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore CI service files.
/.github

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer

# Ignore Docker-related files
/.dockerignore
/Dockerfile*
