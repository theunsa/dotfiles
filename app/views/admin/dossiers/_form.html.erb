<%= form_with model: [ :admin, dossier ], class: "mt-6 space-y-6" do |f| %>
  <% if dossier.errors.any? %>
    <%= render "components/alert", variant: "destructive", title: "#{pluralize(dossier.errors.count, "error")} prohibited this dossier from being saved:",
          description: safe_join(dossier.errors.full_messages.map { |msg| content_tag(:p, msg) }) %>
  <% end %>

  <div>
    <%= render "components/label", for: "dossier_client_name", text: "Client name" %>
    <%= f.text_field :client_name, id: "dossier_client_name", class: "input mt-1 w-full" %>
    <% if dossier.persisted? %>
      <p class="mt-1 text-xs text-muted-foreground">Slug: <code><%= dossier.slug %></code> (fixed — the link must not change)</p>
    <% end %>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= render "components/label", for: "dossier_whatsapp_number", text: "WhatsApp number (E.164)" %>
      <%= f.text_field :whatsapp_number, id: "dossier_whatsapp_number", placeholder: "+27821234567", class: "input mt-1 w-full" %>
    </div>
    <div>
      <%= render "components/label", for: "dossier_whatsapp_text", text: "WhatsApp prefill (optional)" %>
      <%= f.text_field :whatsapp_text, id: "dossier_whatsapp_text", class: "input mt-1 w-full" %>
    </div>
  </div>

  <%= f.fields_for :documents do |doc| %>
    <div>
      <%= render "components/label", for: "document_title", text: "Page title" %>
      <%= doc.text_field :title, id: "document_title", class: "input mt-1 w-full" %>
    </div>
    <div>
      <%= render "components/label", for: "document_body_markdown", text: "Markdown" %>
      <p class="mt-1 text-xs text-muted-foreground">Supports ::steps, ::callout, ::faq and ::accept blocks — same syntax as the prototype.</p>
      <%= doc.text_area :body_markdown, id: "document_body_markdown", rows: 24, class: "textarea mt-1 w-full font-mono text-sm" %>
    </div>
  <% end %>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= render "components/label", for: "dossier_passcode", text: "Passcode (leave blank to keep current)" %>
      <%= f.text_field :passcode, id: "dossier_passcode", autocomplete: "off", class: "input mt-1 w-full" %>
      <% if dossier.passcode_protected? %>
        <label class="mt-2 flex items-center gap-2 text-sm">
          <%= check_box_tag "dossier[remove_passcode]", "1" %> Remove passcode
        </label>
      <% end %>
    </div>
    <div class="flex items-end pb-2">
      <label class="flex items-center gap-2 text-sm font-medium">
        <%= f.check_box :published %> Published
      </label>
    </div>
  </div>

  <%= render "components/button", label: dossier.persisted? ? "Save changes" : "Create dossier", type: "submit", size: "lg" %>
<% end %>
