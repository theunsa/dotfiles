<%= form_with model: [ :admin, dossier ], class: "mt-6 space-y-6" do |f| %>
  <% if dossier.errors.any? %>
    <%= render "components/alert", variant: "destructive", title: "#{pluralize(dossier.errors.count, "error")} prohibited this dossier from being saved:",
          description: safe_join(dossier.errors.full_messages.map { |msg| content_tag(:p, msg) }) %>
  <% end %>

  <div>
    <%= render "components/label", for: "dossier_client_name", text: "Client name" %>
    <%= f.text_field :client_name, id: "dossier_client_name", class: "input mt-1 w-full" %>
    <% if dossier.persisted? %>
      <p class="mt-1 text-xs text-muted-foreground">Slug: <code><%= dossier.slug %></code> (fixed — the link must not change)</p>
    <% end %>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= render "components/label", for: "dossier_whatsapp_number", text: "WhatsApp number (E.164)" %>
      <%= f.text_field :whatsapp_number, id: "dossier_whatsapp_number", placeholder: "+27821234567", class: "input mt-1 w-full" %>
    </div>
    <div>
      <%= render "components/label", for: "dossier_whatsapp_text", text: "WhatsApp prefill (optional)" %>
      <%= f.text_field :whatsapp_text, id: "dossier_whatsapp_text", class: "input mt-1 w-full" %>
    </div>
  </div>

  <%= f.fields_for :documents do |doc| %>
    <div>
      <%= render "components/label", for: "document_title", text: "Page title" %>
      <%= doc.text_field :title, id: "document_title", class: "input mt-1 w-full" %>
    </div>
    <%# Breaks out of the page's max-w-3xl column once the split appears: two
        columns of a 48rem container are narrower than either job needs. The
        `editor-wide` recipe centres it on the viewport instead, so the editor
        gets the whole window and the rest of the form keeps its reading width. %>
    <div class="editor-wide" data-controller="markdown-editor"
         data-markdown-editor-preview-url-value="<%= admin_preview_path %>">
      <%= render "components/label", for: "document_body_markdown", text: "Markdown" %>

      <div class="mt-1 flex flex-wrap items-center gap-2">
        <span class="text-xs text-muted-foreground">Insert:</span>
        <% MarkdownRenderer::SNIPPETS.each do |name, snippet| %>
          <button type="button" class="btn" data-variant="outline" data-size="sm"
                  data-action="markdown-editor#insert"
                  data-snippet="<%= snippet[:body] %>"
                  data-placeholder="<%= snippet[:placeholder] %>">
            <%= snippet[:label] %>
          </button>
        <% end %>

        <details class="ml-auto relative">
          <summary class="btn cursor-pointer list-none" data-variant="ghost" data-size="sm">Formatting help</summary>
          <div class="absolute right-0 z-10 mt-2 w-80 rounded-lg border border-border bg-popover p-4 text-sm text-popover-foreground shadow-md">
            <p class="font-medium">Plain markdown works everywhere:</p>
            <ul class="mt-2 space-y-1 font-mono text-xs text-muted-foreground">
              <li>## Heading &nbsp; ### Subheading</li>
              <li>**bold** &nbsp; *italic* &nbsp; `code`</li>
              <li>- bullet list &nbsp; 1. numbered list</li>
              <li>[link text](https://…)</li>
              <li>| tables | work | &nbsp; > quotes</li>
            </ul>
            <p class="mt-3 text-xs text-muted-foreground">
              The chips insert special blocks — a fenced section
              (<code>```steps</code> … <code>```</code>) holding
              <code>key: value</code> settings. Edit the example text they
              drop in; the preview shows the result as you type.
            </p>
          </div>
        </details>
      </div>

      <div class="mt-2 grid gap-4" data-markdown-editor-target="split">
        <%= doc.text_area :body_markdown, id: "document_body_markdown", rows: 28,
              class: "textarea w-full font-mono text-sm",
              data: { markdown_editor_target: "textarea",
                      action: "markdown-editor#changed" } %>

        <%# Rendered by the real MarkdownRenderer, so it can't drift from the
            client's page. Ships hidden; the controller reveals it and puts the
            wrapper into two columns, so with JS off the textarea is simply a
            full-width field and the chips do nothing. %>
        <%# bg-background, not the textarea's muted fill: the preview should sit
            on the same ground the client's page does. %>
        <div class="w-full overflow-auto rounded-lg border border-border bg-background px-5 py-4 text-foreground"
             data-markdown-editor-target="preview" hidden></div>
      </div>
    </div>
  <% end %>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= render "components/label", for: "dossier_passcode", text: "Passcode (leave blank to keep current)" %>
      <%= f.text_field :passcode, id: "dossier_passcode", autocomplete: "off", class: "input mt-1 w-full" %>
      <% if dossier.passcode_protected? %>
        <label class="mt-2 flex items-center gap-2 text-sm">
          <%= check_box_tag "dossier[remove_passcode]", "1" %> Remove passcode
        </label>
      <% end %>
    </div>
    <div class="flex items-end pb-2">
      <label class="flex items-center gap-2 text-sm font-medium">
        <%= f.check_box :published %> Published
      </label>
    </div>
  </div>

  <%= render "components/button", label: dossier.persisted? ? "Save changes" : "Create dossier", type: "submit", size: "lg" %>
<% end %>
