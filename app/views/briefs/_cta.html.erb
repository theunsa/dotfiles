<% if brief.cta_url %>
  <% card_body = capture do %>
    <p class="font-semibold text-card-foreground">Happy with Step 1?</p>
    <div class="mt-4 flex justify-center">
      <%= render "components/button", label: brief.cta_label, href: brief.cta_url,
            size: "lg", class: "no-underline" %>
    </div>
  <% end %>
  <%# data-block puts the card in the reveal controller's set; data-cta-anchor
      is what the sticky bar watches, so it can stand down while this is on
      screen rather than offering the same button twice. %>
  <div class="brief-cta" data-block="cta" data-cta-anchor>
    <%= render "components/card", class: "not-prose mt-12 text-center", body: card_body %>
  </div>
<% end %>
