<%# Shown only to the signed-in author, on an unpublished dossier's real public
    page. Deliberately not the alert component: this is chrome, not content, and
    must not read as one of the page's own callout alerts. %>
<div class="sticky top-0 z-50 bg-primary px-5 py-2 text-primary-foreground print:hidden" data-draft-banner>
  <div class="mx-auto max-w-2xl text-sm">
    <%# Two rows, so "Edit" stays on the first one at 390px instead of being
        pushed onto a third line of its own by the wrapping explanation. %>
    <div class="flex items-center gap-3">
      <span class="font-semibold">Draft preview</span>
      <%= link_to "Edit", edit_admin_dossier_path(dossier),
            class: "ml-auto font-medium underline underline-offset-2" %>
    </div>
    <p class="mt-0.5 opacity-90">Only you can see this — the link 404s for everyone else.</p>
  </div>
</div>
