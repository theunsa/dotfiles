<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Brief" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Brief">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# Set before paint so there's no flash of the wrong theme; Basecoat's
        dark variant keys off a `.dark` class on <html>, not the media query.
        A theme the reader picked in the brand bar wins over the device. %>
    <script>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem("brief.theme"); } catch (e) {}
        var dark = stored
          ? stored === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);

        // Motion is opt-in and decided before first paint, so a block that
        // animates in never flashes on screen and back out first. Every rule
        // that *hides* something keys off this flag, which means JS failing to
        // boot would leave the client staring at a blank proposal — hence the
        // failsafe: Stimulus stamps motionReady on connect, and if it hasn't
        // within two seconds the flag is dropped and the page renders plain.
        try {
          if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            document.documentElement.dataset.motion = "on";
            setTimeout(function () {
              if (!document.documentElement.dataset.motionReady) {
                delete document.documentElement.dataset.motion;
              }
            }, 2000);
          }
        } catch (e) {}
      })();
    </script>
  </head>

  <body class="bg-background text-foreground">
    <% if notice.present? %>
      <div class="mx-auto max-w-2xl px-5 pt-4">
        <%= render "components/alert", title: notice %>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="mx-auto max-w-2xl px-5 pt-4">
        <%= render "components/alert", variant: "destructive", title: alert %>
      </div>
    <% end %>
    <%= yield %>

    <% if authenticated? %>
      <%# Backs every data-turbo-confirm on the admin side. Rendered only for the
          author — the client's page stays free of admin chrome. %>
      <dialog class="alert-dialog" data-size="sm"
              data-controller="confirm-dialog"
              data-action="close->confirm-dialog#closed">
        <article>
          <header>
            <h2>Are you sure?</h2>
            <p data-confirm-dialog-target="message"></p>
          </header>
          <footer>
            <button type="button" class="btn" data-variant="outline"
                    data-action="confirm-dialog#cancel">Cancel</button>
            <button type="button" class="btn"
                    data-confirm-dialog-target="accept"
                    data-action="confirm-dialog#accept">Continue</button>
          </footer>
        </article>
      </dialog>
    <% end %>
  </body>
</html>
