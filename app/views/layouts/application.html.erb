<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Dossier" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Dossier">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# Set before paint so there's no flash of the wrong theme; Basecoat's
        dark variant keys off a `.dark` class on <html>, not the media query. %>
    <script>
      if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>

  <body class="bg-background text-foreground">
    <% if notice.present? %>
      <div class="mx-auto max-w-2xl px-5 pt-4">
        <%= render "components/alert", title: notice %>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="mx-auto max-w-2xl px-5 pt-4">
        <%= render "components/alert", variant: "destructive", title: alert %>
      </div>
    <% end %>
    <%= yield %>

    <% if authenticated? %>
      <%# Backs every data-turbo-confirm on the admin side. Rendered only for the
          author — the client's page stays free of admin chrome. %>
      <dialog class="alert-dialog" data-size="sm"
              data-controller="confirm-dialog"
              data-action="close->confirm-dialog#closed">
        <article>
          <header>
            <h2>Are you sure?</h2>
            <p data-confirm-dialog-target="message"></p>
          </header>
          <footer>
            <button type="button" class="btn" data-variant="outline"
                    data-action="confirm-dialog#cancel">Cancel</button>
            <button type="button" class="btn"
                    data-confirm-dialog-target="accept"
                    data-action="confirm-dialog#accept">Continue</button>
          </footer>
        </article>
      </dialog>
    <% end %>
  </body>
</html>
