<div class="dossier-accept not-prose my-8" data-block="accept">
  <% label = data["label"].presence || "Accept Step 1" %>
  <% if local_assigns[:preview] %>
    <%# Admin preview: show the button, but never a working one. Clicking a live
        one here would record an acceptance the client never made. %>
    <div class="flex items-center gap-3">
      <%= render "components/button", label: label, size: "lg", type: "button", disabled: true %>
      <span class="text-xs text-muted-foreground">Preview — not clickable</span>
    </div>
  <% elsif defined?(dossier) && dossier %>
    <%# Matched on label, not "any acceptance": a dossier may carry an accept
        block per step, and each has to be acceptable on its own. %>
    <% if (acceptance = dossier.acceptances.find_by(label: label)) %>
      <%= render "components/alert",
            title: "Accepted on #{acceptance.accepted_at.strftime('%-d %B %Y')}",
            icon: content_tag(:svg, content_tag(:path, nil, d: "M20 6 9 17l-5-5"),
              class: "lucide", xmlns: "http://www.w3.org/2000/svg", width: 24, height: 24, viewbox: "0 0 24 24",
              fill: "none", stroke: "currentColor", "stroke-width": 2, "stroke-linecap": "round", "stroke-linejoin": "round") %>
    <% else %>
      <%= form_with url: dossier_acceptances_path(slug: dossier.slug), method: :post do %>
        <%= hidden_field_tag :label, label %>
        <%= render "components/button", label: label, type: "submit", size: "lg" %>
      <% end %>
    <% end %>
  <% end %>
</div>
