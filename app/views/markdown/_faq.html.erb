<%# Wrapped like _callout wraps its alert, so every block carries a data-block
    hook — the accordion component takes no arbitrary attributes. %>
<div class="brief-faq not-prose my-8" data-block="faq">
  <%= render "components/accordion",
        name: "faq-#{block_index}",
        items: (data["items"] || []).map { |item|
          { title: item["label"], content: renderer.inline_html(item["content"]) }
        } %>
</div>
