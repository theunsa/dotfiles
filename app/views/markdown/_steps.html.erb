<section class="dossier-steps not-prose my-8 flex flex-col gap-4" data-block="steps">
  <% (data["items"] || []).each_with_index do |item, index| %>
    <% card_body = capture do %>
      <div class="flex items-baseline gap-3">
        <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-primary/10 text-sm font-semibold text-primary">
          <%= index + 1 %>
        </span>
        <h3 class="text-lg font-semibold tracking-tight text-card-foreground">
          <span class="mr-2 text-sm font-medium text-muted-foreground">Step <%= index + 1 %></span><%= item["title"] %>
        </h3>
      </div>
      <% if item["price"].present? %>
        <p class="mt-3 text-2xl font-bold tracking-tight text-primary"><%= item["price"] %></p>
      <% end %>
      <% if item["body"].present? %>
        <%# A div, not a p: inline_html returns block-level markdown output. %>
        <div class="mt-3 leading-relaxed [&>p+p]:mt-3"><%= renderer.inline_html(item["body"]) %></div>
      <% end %>
      <% if item["note"].present? %>
        <p class="mt-3 text-sm font-medium text-muted-foreground"><%= item["note"] %></p>
      <% end %>
    <% end %>
    <%= render "components/card", class: "border-l-4 border-l-primary", body: card_body %>
  <% end %>
</section>
