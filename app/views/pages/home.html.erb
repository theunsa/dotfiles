<% brand = Rails.application.config.x.brand %>
<main class="mx-auto flex min-h-svh max-w-xl flex-col justify-center gap-3 px-5">
  <h1 class="text-2xl font-semibold"><%= brand[:name] %></h1>
  <p class="opacity-80"><%= brand[:tagline] %></p>
  <p class="text-sm opacity-60"><%= mail_to brand[:contact] %></p>
</main>
