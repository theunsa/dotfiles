<main class="mx-auto max-w-sm px-5 py-16">
  <h1 class="text-xl font-semibold text-foreground">Update your password</h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= render "components/label", for: "password", text: "New password" %>
      <%= form.password_field :password, id: "password", required: true, autocomplete: "new-password",
            placeholder: "Enter new password", maxlength: 72, class: "input mt-1 w-full" %>
    </div>

    <div>
      <%= render "components/label", for: "password_confirmation", text: "Confirm password" %>
      <%= form.password_field :password_confirmation, id: "password_confirmation", required: true,
            autocomplete: "new-password", placeholder: "Repeat new password", maxlength: 72,
            class: "input mt-1 w-full" %>
    </div>

    <%= render "components/button", label: "Save", type: "submit", size: "lg" %>
  <% end %>
</main>
