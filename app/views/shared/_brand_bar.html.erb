<header class="sticky top-0 z-10 border-b border-border bg-background/85 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-2xl items-center gap-3 px-5">
    <span class="size-2.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>
    <%= link_to brand[:name], root_path,
          class: "truncate text-sm font-semibold tracking-tight text-foreground no-underline" %>
    <%# Which icon shows is pure CSS, so it is already right at first paint —
        the controller only unhides the button and keeps its label in step. %>
    <button type="button" class="btn ml-auto" data-variant="ghost" data-size="icon-sm"
            hidden
            aria-label="Switch theme"
            data-controller="theme"
            data-action="theme#toggle">
      <svg class="lucide lucide-moon dark:hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      <svg class="lucide lucide-sun hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
    </button>
  </div>
</header>
