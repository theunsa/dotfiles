<% content_for :title, "Passcode" %>
<% content_for :head do %>
  <meta name="robots" content="noindex, nofollow, noarchive, noimageindex">
<% end %>

<%= render "shared/brand_bar" %>

<main class="mx-auto max-w-sm px-5 py-16">
  <h1 class="text-xl font-semibold text-foreground">This brief is protected</h1>
  <p class="mt-2 text-sm text-muted-foreground">Enter the passcode you received from <%= brand[:name] %>.</p>

  <%= form_with url: brief_unlock_path(slug: @brief.slug), method: :post, class: "mt-6 space-y-4" do |f| %>
    <div>
      <%= render "components/label", for: "passcode", text: "Passcode" %>
      <%= f.password_field :passcode, id: "passcode", autofocus: true, autocomplete: "off",
            class: "input mt-1 w-full" %>
    </div>
    <%= render "components/button", label: "Open brief", type: "submit", size: "lg", class: "w-full" %>
  <% end %>
</main>
