prefix_rule(pattern=["bundle", "install"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["docker", "compose", "exec", "-T", "db", "psql", "-U", "odoo", "-d", "odoo-test", "-P", "pager=off", "-c", "SELECT c.id, c.name, rp.country_id, rc.code AS country, cur.name AS currency FROM res_company c LEFT JOIN res_partner rp ON rp.id = c.partner_id LEFT JOIN res_country rc ON rc.id = rp.country_id LEFT JOIN res_currency cur ON cur.id = c.currency_id ORDER BY c.id", "-c", "SELECT COUNT(*) FILTER (WHERE deprecated IS NOT TRUE) AS active_accounts FROM account_account"], decision="allow")
prefix_rule(pattern=["docker", "compose", "exec", "-T", "db", "psql", "-U", "odoo", "-d", "odoo-test", "-P", "pager=off", "-c", "SELECT m.model, COUNT(f.id) AS fields FROM ir_model m LEFT JOIN ir_model_fields f ON f.model_id=m.id WHERE m.model IN ('account.account','account.journal','account.move','account.move.line','account.payment','account.tax','account.bank.statement','account.bank.statement.line') GROUP BY m.model ORDER BY m.model;", "-c", "SELECT name, state, latest_version FROM ir_module_module WHERE name IN ('account','account_accountant','account_reports','l10n_za','stock_account','account_asset') ORDER BY name;", "-c", "SELECT COUNT(*) AS journal_entries FROM account_move; SELECT COUNT(*) AS journal_items FROM account_move_line;"], decision="allow")
prefix_rule(pattern=["docker", "compose"], decision="allow")
prefix_rule(pattern=["git", "clone"], decision="allow")
prefix_rule(pattern=["git", "-C", "oca/mis-templates-preview", "fetch", "--depth", "1", "origin", "refs/pull/1485/head"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "docker compose run --rm --no-deps odoo odoo -d odoo-mis-template-check-20260908 --addons-path=/mnt/extra-addons,/mnt/oca/* -i mis_template_financial_report,l10n_za --without-demo=all --test-enable --test-tags /mis_template_financial_report --stop-after-init --http-port=8079 --max-cron-threads=0 --log-level=test"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "docker compose exec -T odoo sh -lc \"grep -R \\\"class AccountBankStatementLine\\|statement_line_id\\|move_id = fields.Many2one\\|statement_id = fields.Many2one\\\" -n /usr/lib/python3/dist-packages/odoo/addons/account/models/account_bank_statement.py /usr/lib/python3/dist-packages/odoo/addons/account/models/account_move.py /usr/lib/python3/dist-packages/odoo/addons/account/models/account_move_line.py 2>/dev/null | head -100\""], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "docker compose exec -T odoo sh -lc \"sed -n '205,250p' /usr/lib/python3/dist-packages/odoo/addons/account/models/account_move.py; sed -n '20,48p' /usr/lib/python3/dist-packages/odoo/addons/account/models/account_move_line.py; ls /usr/lib/python3/dist-packages/odoo/addons/account/models/*statement*; grep -R \\\"_name = 'account.bank.statement.line'\\|move_id = fields\\\" -n /usr/lib/python3/dist-packages/odoo/addons/account/models/*statement* 2>/dev/null\""], decision="allow")
