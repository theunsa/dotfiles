#!/usr/bin/env bash
#
# Push the generated static site to the host.
#
#   pnpm deploy          # generate, then rsync
#   ./bin/deploy         # rsync only (assumes .output/public is current)
#
# Configure once in .env (see .env.example) or export in your shell:
#
#   DEPLOY_HOST=user@server.example.com
#   DEPLOY_PATH=/var/www/dossier
#
set -euo pipefail

cd "$(dirname "$0")/.."

# shellcheck disable=SC1091
[ -f .env ] && set -a && . ./.env && set +a

: "${DEPLOY_HOST:?set DEPLOY_HOST (e.g. user@server.example.com)}"
: "${DEPLOY_PATH:?set DEPLOY_PATH (e.g. /var/www/dossier)}"

if [ ! -d .output/public ]; then
  echo "No .output/public — run 'pnpm generate' first." >&2
  exit 1
fi

echo "Deploying .output/public → ${DEPLOY_HOST}:${DEPLOY_PATH}"

# --delete keeps the host free of pages whose client folder was removed.
rsync -avz --delete \
  --chmod=D755,F644 \
  .output/public/ \
  "${DEPLOY_HOST}:${DEPLOY_PATH}/"

echo "Done."
